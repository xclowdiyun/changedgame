HOST=127.0.0.1
PORT=8000
# Local frontend origin. Use the public HTTPS Activity origin in production.
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Copy the values from Discord Developer Portal after creating the application.
# Keep the secret only in backend/.env; never put it in frontend files.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_REDIRECT_URI=
