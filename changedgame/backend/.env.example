HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:8000

# Only needed to show real Discord names inside Discord (otherwise players get random names).
# Get both on https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your free fixed ngrok domain (no https://). Written by setup_ngrok.bat.
NGROK_DOMAIN=

# Optional
# REQUIRE_DISCORD_AUTH=true      only players signed in through Discord may join (do not use for local tests)
# RECONNECT_GRACE_SECONDS=90     keep a disconnected player's progress this long
# FORCE_SKIP_AFTER_SECONDS=45    when "skip idle players" becomes available
